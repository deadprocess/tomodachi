<Window x:Class="Tomodachi.Wallpaper.WallpaperOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Tomodachi.Wallpaper"
        Title="Wallpaper Picker"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnPreviewMouseWheel"
        MouseLeftButtonUp="OnBackdropClick" Deactivated="OnDeactivated">

  <Window.Resources>
    <!-- Werden in UpdateMetrics passend zum jeweiligen Monitor gesetzt -->
    <sys:Double x:Key="CardWidth">200</sys:Double>
    <sys:Double x:Key="CardHeight">390</sys:Double>
    <Thickness x:Key="CardImageMargin">-28,0</Thickness>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:WallpaperItem}">
      <Grid x:Name="Card"
            Width="{DynamicResource CardWidth}" Height="{DynamicResource CardHeight}"
            Margin="{x:Static local:CardLayout.CardMargin}"
            ClipToBounds="True" Background="#FF17141F" Cursor="Hand"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnCardClick">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform/>
            <SkewTransform AngleX="{x:Static local:CardLayout.Skew}"/>
          </TransformGroup>
        </Grid.RenderTransform>

        <!-- Platzhalter, bis das Vorschaubild geladen ist -->
        <TextBlock Text="{Binding Name}" Margin="14" FontSize="12" Foreground="#88FFFFFF"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Gegenschräge: nur der Rahmen ist schräg, das Bild selbst bleibt gerade -->
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
               Margin="{DynamicResource CardImageMargin}" RenderTransformOrigin="0.5,0.5"
               RenderOptions.BitmapScalingMode="HighQuality">
          <Image.RenderTransform>
            <SkewTransform AngleX="{x:Static local:CardLayout.CounterSkew}"/>
          </Image.RenderTransform>
        </Image>

        <Rectangle x:Name="Dim" Fill="Black" Opacity="0.2" IsHitTestVisible="False"/>
        <Border x:Name="Frame" BorderBrush="White" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Card" To="1.06" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                <DoubleAnimation Storyboard.TargetName="Card" To="1.06" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.15"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Scene" Opacity="0">
    <!-- Abdunkeln zur Mitte hin; oben und unten bleibt der Desktop gut sichtbar -->
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#59000000"/>
        <GradientStop Offset="0.5" Color="#B8000000"/>
        <GradientStop Offset="1" Color="#59000000"/>
      </LinearGradientBrush>
    </Grid.Background>

    <StackPanel VerticalAlignment="Center">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="Rise"/>
      </StackPanel.RenderTransform>

      <TextBlock x:Name="DateText" HorizontalAlignment="Center" Foreground="White"
                 FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI" FontSize="40"/>

      <!-- Canvas, damit das Kartenband breiter als der Bildschirm sein darf, ohne abgeschnitten zu werden -->
      <Canvas x:Name="Band" Height="440">
        <ItemsControl x:Name="Cards" Focusable="False" ItemTemplate="{StaticResource CardTemplate}">
          <ItemsControl.RenderTransform>
            <TranslateTransform x:Name="Scroll"/>
          </ItemsControl.RenderTransform>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Style.Triggers>
                <!-- Die vergrößerte Auswahl liegt über ihren Nachbarn -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter Property="Panel.ZIndex" Value="1"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </Canvas>

      <TextBlock x:Name="HintText" HorizontalAlignment="Center" Foreground="White" Opacity="0.5"
                 FontFamily="Bahnschrift, Segoe UI" FontSize="13"/>
    </StackPanel>
  </Grid>
</Window>
