<UserControl x:Class="Tomodachi.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tomodachi.Localization"
             FontFamily="{StaticResource UiFont}"
             KeyboardNavigation.TabNavigation="None">
    <UserControl.Resources>
        <!-- Rechtsklick-Menü der Treffer -->
        <ContextMenu x:Key="ResultMenu" Style="{StaticResource NotchContextMenu}" Closed="OnResultMenuClosed">
            <MenuItem Header="{loc:Tr Launcher_Open}" Tag="&#xE768;" Click="OnMenuLaunch" />
            <MenuItem Header="{loc:Tr Launcher_RunAsAdmin}" Tag="&#xE7EF;" Click="OnMenuLaunchElevated" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Suchfeld -->
        <Border Height="44" CornerRadius="12" Padding="14,0" Background="{StaticResource InputBrush}">
            <Grid>
                <TextBlock x:Name="Placeholder" Text="{loc:Tr Launcher_Search}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="16" IsHitTestVisible="False" />
                <TextBox x:Name="Query" VerticalContentAlignment="Center" FontSize="16"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}"
                         TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
            </Grid>
        </Border>

        <!-- Treffer -->
        <ListBox x:Name="Results" Grid.Row="1" Margin="0,10,0,0"
                 Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 PreviewMouseLeftButtonUp="OnResultClicked"
                 PreviewMouseRightButtonUp="OnResultRightClicked">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" CornerRadius="10" Padding="10,0" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="NoResults" Grid.Row="1" Text="{loc:Tr Launcher_NoResults}" Visibility="Collapsed"
                   HorizontalAlignment="Center" Margin="0,24,0,0"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
    </Grid>
</UserControl>
