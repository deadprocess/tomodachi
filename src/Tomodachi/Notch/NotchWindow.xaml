<overlay:OverlayWindow x:Class="Tomodachi.Notch.NotchWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tomodachi.Localization"
                       xmlns:overlay="clr-namespace:Tomodachi.Overlay"
                       xmlns:notch="clr-namespace:Tomodachi.Notch"
                       xmlns:launcher="clr-namespace:Tomodachi.Launcher"
                       xmlns:widgets="clr-namespace:Tomodachi.Widgets"
                       Title="tomodachi notch"
                       FontFamily="{StaticResource UiFont}"
                       UseLayoutRounding="True">
    <!--
        Das Fenster hat immer die maximale (ausgeklappte) Größe und ist bis auf die Notch voll transparent,
        also dort klickdurchlässig. So muss beim Animieren nie das Fenster selbst die Größe ändern.
        Ausgeklappt: Kopfzeile mit Reitern (Apps · Widgets · Fenster), Profilbild und Uhrzeit, darunter der Reiter-Inhalt.
    -->
    <Grid x:Name="Root">
        <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Top">
            <notch:NotchShape x:Name="Shape"
                              Fill="{StaticResource SurfaceBrush}"
                              Stroke="{StaticResource SurfaceBorderBrush}"
                              EarRadius="{StaticResource NotchEarRadius}" />

            <Grid Margin="{Binding EarRadius, ElementName=Shape, Converter={x:Static notch:EarMarginConverter.Instance}}"
                  ClipToBounds="True">

                <!-- Kopfzeile: nur ausgeklappt sichtbar -->
                <Grid x:Name="Header" Height="40" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,2,0,0">
                        <RadioButton x:Name="TabApps" Style="{StaticResource TabButton}" Content="{loc:Tr Tab_Apps}" GroupName="NotchTabs" Checked="OnTabChecked" />
                        <RadioButton x:Name="TabWidgets" Style="{StaticResource TabButton}" Content="{loc:Tr Tab_Widgets}" GroupName="NotchTabs" Checked="OnTabChecked" />
                        <RadioButton x:Name="TabWindows" Style="{StaticResource TabButton}" Content="{loc:Tr Tab_Windows}" GroupName="NotchTabs" Checked="OnTabChecked" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,12,0">
                        <TextBlock x:Name="HeaderTime" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                        <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" GroupName="NotchTabs" Checked="OnTabChecked"
                                     Content="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0" ToolTip="{loc:Tr Tab_Settings}" />
                        <RadioButton x:Name="TabPower" Style="{StaticResource TabButton}" GroupName="NotchTabs" Checked="OnTabChecked"
                                     Content="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0" ToolTip="{loc:Tr Tab_Power}" />
                    </StackPanel>
                </Grid>

                <!-- Profilbild, Klick öffnet die Widgets -->
                <Grid x:Name="Avatar" Width="{StaticResource AvatarSize}" Height="{StaticResource AvatarSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"
                      Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnAvatarClicked">
                    <Image x:Name="AvatarImage" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                        </Image.Clip>
                    </Image>
                    <Ellipse Stroke="{StaticResource AvatarRingBrush}" StrokeThickness="1" />
                </Grid>

                <!-- Reiter-Inhalte: feste Größe, damit beim Morphen nichts umbricht, sondern nur freigelegt wird -->
                <launcher:LauncherView x:Name="Launcher" Visibility="Collapsed" Opacity="0"
                                       Width="608" Height="406" Margin="0,48,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                <widgets:WidgetsView x:Name="Widgets" Visibility="Collapsed" Opacity="0"
                                     Width="928" Height="406" Margin="0,48,0,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" />
                <widgets:WindowsView x:Name="Windows" Visibility="Collapsed" Opacity="0"
                                     Width="608" Height="406" Margin="0,48,0,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" />
                <notch:SettingsView x:Name="Settings" Visibility="Collapsed" Opacity="0"
                                    Width="608" Height="514" Margin="0,48,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" />
                <notch:PowerView x:Name="Power" Visibility="Collapsed" Opacity="0"
                                 Width="608" Margin="0,48,0,0"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Grid>
</overlay:OverlayWindow>
