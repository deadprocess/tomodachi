<UserControl x:Class="Tomodachi.Widgets.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tomodachi.Localization"
             xmlns:widgets="clr-namespace:Tomodachi.Widgets"
             FontFamily="{StaticResource UiFont}">
    <!-- Fenster-Reiter der Notch (5.3): offene Fenster wie in Alt+Tab. DataContext = WidgetViewModel. -->
    <!-- Rechtsklick: WindowMenu (gemeinsam mit der Fensterleiste) -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl ItemsSource="{Binding Windows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type widgets:WindowItem}">
                    <Border x:Name="Row" Height="44" CornerRadius="10" Padding="10,0" Background="Transparent" Cursor="Hand"
                            Tag="{Binding Handle}" MouseLeftButtonUp="OnWindowClicked" MouseRightButtonUp="OnWindowRightClicked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Label}" FontSize="14"
                                       Margin="12,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MinimizedHint" Grid.Column="2" Text="{loc:Tr Windows_Minimized}" Style="{StaticResource Muted}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                                    Content="&#xE8BB;" Tag="{Binding Handle}" Click="OnWindowClose" ToolTip="{loc:Tr Windows_Close}" Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Minimized}" Value="True">
                            <Setter TargetName="Title" Property="Opacity" Value="0.6" />
                            <Setter TargetName="MinimizedHint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
