<UserControl x:Class="Tomodachi.Widgets.WidgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tomodachi.Localization"
             xmlns:widgets="clr-namespace:Tomodachi.Widgets"
             FontFamily="{StaticResource UiFont}">
    <!-- Widgets-Reiter der Notch: drei Spalten. DataContext = WidgetViewModel. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Spalte 1: Uhr & Kalender (5.1) ===== -->
        <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextBrush}" FontSize="40" FontWeight="Light" />
                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FontSize="13" Margin="2,-4,0,12" />
                <TextBlock Text="{Binding CalendarTitle}" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,0,0,6" />
                <!-- Wochentage in der Sprache der Oberfläche, ab Montag -->
                <ItemsControl ItemsSource="{Binding WeekdayNames}" Margin="0,0,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type widgets:DayItem}">
                            <Border x:Name="Cell" Width="28" Height="28" CornerRadius="14" Margin="0,1">
                                <TextBlock x:Name="Number" Text="{Binding Text}" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="Number" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                    <Setter TargetName="Number" Property="Opacity" Value="0.3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Number" Property="Foreground" Value="#0E0E12" />
                                    <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Spalte 2: Media (4.6) + Laufwerke (4.4) ===== -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <!-- ohne Wiedergabe -->
                    <TextBlock Text="{loc:Tr Widgets_NoMedia}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,30"
                               Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource TrackBrush}">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,56,56" RadiusX="10" RadiusY="10" />
                                </Border.Clip>
                                <Image Source="{Binding MediaCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" Style="{StaticResource Label}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding MediaSource}" Style="{StaticResource Muted}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0" Height="4">
                            <Border Background="{StaticResource TrackBrush}" CornerRadius="2" />
                            <Border Background="{StaticResource TextBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding MediaProgress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding MediaTime}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="OnPrevious" ToolTip="{loc:Tr Widgets_Previous}" />
                                <Button Style="{StaticResource IconButton}" Click="OnPlayPause" Width="40" Height="40" FontSize="19">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MediaPlaying}" Value="True">
                                                        <Setter Property="Text" Value="&#xE769;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="OnNext" ToolTip="{loc:Tr Widgets_Next}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Widgets_Drives}" Style="{StaticResource CardHeader}" />
                    <ItemsControl ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type widgets:VolumeItem}">
                                <StackPanel Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="0,0,110,0" />
                                        <TextBlock Text="{Binding Usage}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Height="4" Margin="0,4,0,0">
                                        <Border Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Fraction}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type widgets:DiskItem}">
                                <StackPanel Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="12" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Spalte 3: Schnelleinstellungen + System (4.3) + Netzwerk (4.5) ===== -->
        <!-- Scrollbar unsichtbar: Nur mit aufgeklappter WLAN-Liste (Laptops) wird die Spalte länger als der Reiter -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Quick}">
                    <TextBlock Text="{loc:Tr Widgets_Quick}" Style="{StaticResource CardHeader}" />

                    <!-- WLAN / Bluetooth: nur mit passender Hardware -->
                    <Grid Margin="0,0,0,10" Visibility="{Binding HasRadios, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuickTile}" Tag="{Binding WifiOn}" Click="OnWifi"
                                Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Net_WiFi}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource QuickTile}" Tag="{Binding BluetoothOn}" Click="OnBluetooth" Margin="0"
                                Visibility="{Binding HasBluetooth, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Quick_Bluetooth}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- WLAN-Netze -->
                    <StackPanel Visibility="{Binding WifiOn, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                        <Button Style="{StaticResource RowButton}" Click="OnNetworks">
                            <Grid>
                                <TextBlock Text="{loc:Tr Quick_Networks}" FontSize="12.5" />
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <StackPanel Visibility="{Binding ShowNetworks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Tr Quick_NoNetworks}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="8,2,8,4"
                                       Visibility="{Binding NoNetworks, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Networks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type widgets:WifiNetworkItem}">
                                        <Button Style="{StaticResource RowButton}" Tag="{Binding Ssid}" Click="OnNetworkClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SignalIcon}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Ssid}" FontSize="12.5" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock x:Name="State" Grid.Column="2" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Secured}" Value="True">
                                                <Setter TargetName="State" Property="Text" Value="&#xE72E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                <Setter TargetName="State" Property="Text" Value="&#xE73E;" />
                                                <Setter TargetName="State" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Lautstärke: Lautsprecher-Knopf = Stumm, Regler, Prozent -->
                    <Grid Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14" Click="OnMute" ToolTip="{loc:Tr Quick_Mute}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE767;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                <Setter Property="Text" Value="&#xE74F;" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="6,0" VerticalAlignment="Center"
                                Value="{Binding Volume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Ausgabegerät: Klick klappt die Liste auf -->
                    <StackPanel Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <Button Style="{StaticResource RowButton}" Click="OnDevices">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="12.5" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Devices}" Margin="16,0,0,0"
                                      Visibility="{Binding ShowDevices, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type widgets:AudioDeviceItem}">
                                    <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" Click="OnDeviceClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Check" Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Hidden" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Widgets_System}" Style="{StaticResource CardHeader}" />
                    <Grid>
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource Label}" Margin="0,0,50,0" />
                        <TextBlock Text="{Binding CpuValue}" Style="{StaticResource Value}" Foreground="{StaticResource CpuBrush}" />
                    </Grid>
                    <widgets:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource CpuBrush}" Height="22" Margin="0,4,0,8" />

                    <Grid>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource Label}" Margin="0,0,50,0" />
                        <TextBlock Text="{Binding GpuValue}" Style="{StaticResource Value}" Foreground="{StaticResource GpuBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Muted}" FontSize="11.5" />
                    <widgets:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource GpuBrush}" Height="22" Margin="0,4,0,8" />

                    <Grid>
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="{loc:Tr Widgets_Memory}" /><Run Text="  " /><Run Text="{Binding RamDetail, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" />
                        </TextBlock>
                        <TextBlock Text="{Binding RamValue}" Style="{StaticResource Value}" Foreground="{StaticResource RamBrush}" />
                    </Grid>
                    <widgets:Sparkline Values="{Binding RamHistory}" Stroke="{StaticResource RamBrush}" Height="22" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Widgets_Network}" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding NetTitle}" Style="{StaticResource Label}" FontSize="12.5" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="↓ " Foreground="{StaticResource DownBrush}" /><Run Text="{Binding NetDown, Mode=OneWay}" />
                            </TextBlock>
                            <widgets:Sparkline Values="{Binding DownHistory}" Maximum="{Binding NetScale}" Stroke="{StaticResource DownBrush}" Height="22" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="↑ " Foreground="{StaticResource UpBrush}" /><Run Text="{Binding NetUp, Mode=OneWay}" />
                            </TextBlock>
                            <widgets:Sparkline Values="{Binding UpHistory}" Maximum="{Binding NetScale}" Stroke="{StaticResource UpBrush}" Height="22" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
