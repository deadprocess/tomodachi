<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 für die WinRT-APIs (Media-Steuerung) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- tools/publish.ps1 baut mit -r win-x64: so steht der RID-Graph in packages.lock.json (Locked-Modus) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Tomodachi.Program</StartupObject>
    <AssemblyName>tomodachi</AssemblyName>
    <RootNamespace>Tomodachi</RootNamespace>
    <Version>1.6.1</Version>
    <!-- Oberfläche: Englisch im Haupt-Assembly, Deutsch als Satellit (Localization/Strings.de.resx) -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- Läuft über die Aufgabe elevated, erbt aber die Umgebung des Users (HKCU\Environment). DOTNET_STARTUP_HOOKS dürfte
         sonst jedes Programm des Users setzen und damit eigenen Code in den Admin-Prozess laden. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- publish.ps1 baut als Single-File; der Analyzer dazu zieht Microsoft.NET.ILLink.Tasks. Immer an, damit die
         Lock-Datei für Build, Test und Publish dieselbe ist (sonst scheitert Publish im Locked-Modus mit NU1004). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tomodachi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Neutrales Standardbild. Eigene Bilder liegen in %APPDATA%\tomodachi\avatar.png, nie in der Exe (tools\publish.ps1 prüft das). -->
    <Resource Include="..\..\assets\avatar\default.png" Link="Assets\avatar.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.6 nutzt nur PawnIO (falls installiert), kein WinRing0. Ohne Treiber fehlen nur CPU-Temperaturen. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Eigene Main in Program.cs (Watchdog/CLI-Modi laufen ohne WPF-App) -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
